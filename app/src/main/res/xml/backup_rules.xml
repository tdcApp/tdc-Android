<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude Jetpack DataStore preferences (stored in files/datastore/) -->
    <exclude domain="file" path="datastore" />
    <!-- Exclude Room SQLite databases -->
    <exclude domain="database" path="." />
    <!-- Exclude any standard Shared Preferences -->
    <exclude domain="sharedpref" path="." />
    <!-- Exclude app private internal root files -->
    <exclude domain="root" path="." />
</full-backup-content>
