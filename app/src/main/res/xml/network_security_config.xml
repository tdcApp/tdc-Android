<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly disallow cleartext HTTP traffic across the entire app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Only trust validated system certificate authorities; rejects user-installed proxy CA certs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
